            "exec": [
              "\npm.test(\"TC-04: HTTP Status = 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"TC-04: Нет блюд с несовместимыми ингредиентами\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.items).to.be.an(\"array\");\n    pm.expect(data.items).to.have.lengthOf(0);\n    pm.expect(data.total).to.eql(0);\n});\n\npm.test(\"TC-04: Корректная пагинация\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.page).to.eql(1);\n    pm.expect(data.pageSize).to.eql(20);\n});\n"
            ]
