    {
      "name": "TC-04 — Two Ingredients",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"TC-04 Positive: HTTP Status = 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"TC-04 Positive: Найдено 2 блюда\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.items).to.be.an(\"array\");\n    pm.expect(data.total).to.eql(2);\n    pm.expect(data.items).to.have.lengthOf(2);\n});\n\npm.test(\"TC-04 Positive: Возвращены ожидаемые блюда\", function () {\n    const data = pm.response.json();\n\n    const actualIds = data.items.map(dish => dish.id).sort();\n    const expectedIds = [141, 231].sort();\n\n    pm.expect(actualIds).to.eql(expectedIds);\n});\n\npm.test(\"TC-04 Positive: Корректная пагинация\", function () {\n    const data = pm.response.json();\n\n    pm.expect(data.page).to.eql(1);\n    pm.expect(data.pageSize).to.eql(20);\n});\n"
            ]
          }
